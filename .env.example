# Copy this file to `.env` and set your own GCP project id:
#     cp .env.example .env
#
# This is NOT a secret. It only tells BigQuery which project RUNS/BILLS the query.
# The data comes from the PUBLIC dataset `bigquery-public-data.thelook_ecommerce`,
# so any project with BigQuery enabled works (a free Sandbox project is fine).
#
# Credentials are handled SEPARATELY and are never stored here:
#     gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
